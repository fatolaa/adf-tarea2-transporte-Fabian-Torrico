{
	"name": "df_bronze_rutas",
	"properties": {
		"description": "Capa bronze: une Rutas de CSV (2020-2021), Excel 2022, Excel 2023 y Azure SQL (2024-2025) sin limpiar. AnioFuente identifica el origen de cada fila.",
		"folder": {
			"name": "Bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_rutas_csv",
						"type": "DatasetReference"
					},
					"name": "csv"
				},
				{
					"dataset": {
						"referenceName": "bronze_rutas_2022_xls",
						"type": "DatasetReference"
					},
					"name": "xls2022"
				},
				{
					"dataset": {
						"referenceName": "bronze_rutas_2023_xls",
						"type": "DatasetReference"
					},
					"name": "xls2023"
				},
				{
					"dataset": {
						"referenceName": "bronze_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "sql"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sw_bronze_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "sinkBronze"
				}
			],
			"transformations": [
				{
					"name": "renombrarCsv"
				},
				{
					"name": "renombrarXls2022"
				},
				{
					"name": "renombrarXls2023"
				},
				{
					"name": "origenCsv"
				},
				{
					"name": "origenXls2022"
				},
				{
					"name": "origenXls2023"
				},
				{
					"name": "unirFuentes"
				}
			],
			"scriptLines": [
				"source(output(",
				"\t\tcod_ruta as string,",
				"\t\tnombre_ruta as string,",
				"\t\torigen as string,",
				"\t\tdestino as string,",
				"\t\tfecha_desde as string,",
				"\t\tfecha_hasta as string,",
				"\t\testado as string",
				"\t),",
				"\tallowSchemaDrift: true,",
				"\tvalidateSchema: false,",
				"\tignoreNoFilesFound: false) ~> csv",
				"source(output(",
				"\t\tcod_ruta as string,",
				"\t\tnombre_ruta as string,",
				"\t\torigen as string,",
				"\t\tdestino as string,",
				"\t\tfecha_desde as string,",
				"\t\tfecha_hasta as string,",
				"\t\testado as string",
				"\t),",
				"\tallowSchemaDrift: true,",
				"\tvalidateSchema: false,",
				"\tignoreNoFilesFound: false) ~> xls2022",
				"source(output(",
				"\t\tcod_ruta as string,",
				"\t\tnombre_ruta as string,",
				"\t\torigen as string,",
				"\t\tdestino as string,",
				"\t\tfecha_desde as string,",
				"\t\tfecha_hasta as string,",
				"\t\testado as string",
				"\t),",
				"\tallowSchemaDrift: true,",
				"\tvalidateSchema: false,",
				"\tignoreNoFilesFound: false) ~> xls2023",
				"source(output(",
				"\t\tAnioFuente as string,",
				"\t\tRutaHistoricaId as string,",
				"\t\tCodigoRuta as string,",
				"\t\tNombreRuta as string,",
				"\t\tOrigen as string,",
				"\t\tDestino as string,",
				"\t\tVigenciaDesde as string,",
				"\t\tVigenciaHasta as string,",
				"\t\tEstado as string",
				"\t),",
				"\tallowSchemaDrift: true,",
				"\tvalidateSchema: false,",
				"\tisolationLevel: 'READ_UNCOMMITTED',",
				"\tformat: 'table') ~> sql",
				"csv select(mapColumn(",
				"\t\tRutaHistoricaId = cod_ruta,",
				"\t\tNombreRuta = nombre_ruta,",
				"\t\tOrigen = origen,",
				"\t\tDestino = destino,",
				"\t\tVigenciaDesde = fecha_desde,",
				"\t\tVigenciaHasta = fecha_hasta,",
				"\t\tEstado = estado",
				"\t),",
				"\tskipDuplicateMapInputs: true,",
				"\tskipDuplicateMapOutputs: true) ~> renombrarCsv",
				"xls2022 select(mapColumn(",
				"\t\tRutaHistoricaId = cod_ruta,",
				"\t\tNombreRuta = nombre_ruta,",
				"\t\tOrigen = origen,",
				"\t\tDestino = destino,",
				"\t\tVigenciaDesde = fecha_desde,",
				"\t\tVigenciaHasta = fecha_hasta,",
				"\t\tEstado = estado",
				"\t),",
				"\tskipDuplicateMapInputs: true,",
				"\tskipDuplicateMapOutputs: true) ~> renombrarXls2022",
				"xls2023 select(mapColumn(",
				"\t\tRutaHistoricaId = cod_ruta,",
				"\t\tNombreRuta = nombre_ruta,",
				"\t\tOrigen = origen,",
				"\t\tDestino = destino,",
				"\t\tVigenciaDesde = fecha_desde,",
				"\t\tVigenciaHasta = fecha_hasta,",
				"\t\tEstado = estado",
				"\t),",
				"\tskipDuplicateMapInputs: true,",
				"\tskipDuplicateMapOutputs: true) ~> renombrarXls2023",
				"renombrarCsv derive(AnioFuente = '2020-2021') ~> origenCsv",
				"renombrarXls2022 derive(AnioFuente = '2022') ~> origenXls2022",
				"renombrarXls2023 derive(AnioFuente = '2023') ~> origenXls2023",
				"origenCsv, origenXls2022, origenXls2023, sql union(byName: true)~> unirFuentes",
				"unirFuentes sink(allowSchemaDrift: true,",
				"\tvalidateSchema: false,",
				"\tinput(",
				"\t\tAnioFuente as string,",
				"\t\tRutaHistoricaId as string,",
				"\t\tCodigoRuta as string,",
				"\t\tNombreRuta as string,",
				"\t\tOrigen as string,",
				"\t\tDestino as string,",
				"\t\tVigenciaDesde as string,",
				"\t\tVigenciaHasta as string,",
				"\t\tEstado as string",
				"\t),",
				"\tdeletable:false,",
				"\tinsertable:true,",
				"\tupdateable:false,",
				"\tupsertable:false,",
				"\tformat: 'table',",
				"\tskipDuplicateMapInputs: true,",
				"\tskipDuplicateMapOutputs: true,",
				"\terrorHandlingOption: 'stopOnFirstError',",
				"\tmapColumn(",
				"\t\tAnioFuente,",
				"\t\tRutaHistoricaId,",
				"\t\tCodigoRuta,",
				"\t\tNombreRuta,",
				"\t\tOrigen,",
				"\t\tDestino,",
				"\t\tVigenciaDesde,",
				"\t\tVigenciaHasta,",
				"\t\tEstado",
				"\t)) ~> sinkBronze"
			]
		}
	}
}