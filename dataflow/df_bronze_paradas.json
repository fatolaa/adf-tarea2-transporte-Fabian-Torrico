{
	"name": "df_bronze_paradas",
	"properties": {
		"description": "Capa bronze: une Paradas de CSV (2020-2021), Excel 2022, Excel 2023 y Azure SQL (2024-2025) sin limpiar. AnioFuente identifica el origen de cada fila.",
		"folder": {
			"name": "Bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_paradas_csv",
						"type": "DatasetReference"
					},
					"name": "csv"
				},
				{
					"dataset": {
						"referenceName": "bronze_paradas_2022_xls",
						"type": "DatasetReference"
					},
					"name": "xls2022"
				},
				{
					"dataset": {
						"referenceName": "bronze_paradas_2023_xls",
						"type": "DatasetReference"
					},
					"name": "xls2023"
				},
				{
					"dataset": {
						"referenceName": "bronze_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sql"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sw_bronze_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sinkBronze"
				}
			],
			"transformations": [
				{
					"name": "renombrarCsv"
				},
				{
					"name": "renombrarXls2022"
				},
				{
					"name": "renombrarXls2023"
				},
				{
					"name": "origenCsv"
				},
				{
					"name": "origenXls2022"
				},
				{
					"name": "origenXls2023"
				},
				{
					"name": "unirFuentes"
				}
			],
			"scriptLines": [
				"source(output(",
				"\t\tnro_parada as string,",
				"\t\tnombre_parada as string,",
				"\t\tzona as string,",
				"\t\tlatitud as string,",
				"\t\tlongitud as string,",
				"\t\tfecha_desde as string,",
				"\t\tfecha_hasta as string,",
				"\t\testado as string",
				"\t),",
				"\tallowSchemaDrift: true,",
				"\tvalidateSchema: false,",
				"\tignoreNoFilesFound: false) ~> csv",
				"source(output(",
				"\t\tnro_parada as string,",
				"\t\tnombre_parada as string,",
				"\t\tzona as string,",
				"\t\tlatitud as string,",
				"\t\tlongitud as string,",
				"\t\tfecha_desde as string,",
				"\t\tfecha_hasta as string,",
				"\t\testado as string",
				"\t),",
				"\tallowSchemaDrift: true,",
				"\tvalidateSchema: false,",
				"\tignoreNoFilesFound: false) ~> xls2022",
				"source(output(",
				"\t\tnro_parada as string,",
				"\t\tnombre_parada as string,",
				"\t\tzona as string,",
				"\t\tlatitud as string,",
				"\t\tlongitud as string,",
				"\t\tfecha_desde as string,",
				"\t\tfecha_hasta as string,",
				"\t\testado as string",
				"\t),",
				"\tallowSchemaDrift: true,",
				"\tvalidateSchema: false,",
				"\tignoreNoFilesFound: false) ~> xls2023",
				"source(output(",
				"\t\tAnioFuente as string,",
				"\t\tParadaHistoricaId as string,",
				"\t\tCodigoPublicado as string,",
				"\t\tNombreParada as string,",
				"\t\tZona as string,",
				"\t\tLatitud as string,",
				"\t\tLongitud as string,",
				"\t\tVigenciaDesde as string,",
				"\t\tVigenciaHasta as string,",
				"\t\tEstado as string",
				"\t),",
				"\tallowSchemaDrift: true,",
				"\tvalidateSchema: false,",
				"\tisolationLevel: 'READ_UNCOMMITTED',",
				"\tformat: 'table') ~> sql",
				"csv select(mapColumn(",
				"\t\tParadaHistoricaId = nro_parada,",
				"\t\tNombreParada = nombre_parada,",
				"\t\tZona = zona,",
				"\t\tLatitud = latitud,",
				"\t\tLongitud = longitud,",
				"\t\tVigenciaDesde = fecha_desde,",
				"\t\tVigenciaHasta = fecha_hasta,",
				"\t\tEstado = estado",
				"\t),",
				"\tskipDuplicateMapInputs: true,",
				"\tskipDuplicateMapOutputs: true) ~> renombrarCsv",
				"xls2022 select(mapColumn(",
				"\t\tParadaHistoricaId = nro_parada,",
				"\t\tNombreParada = nombre_parada,",
				"\t\tZona = zona,",
				"\t\tLatitud = latitud,",
				"\t\tLongitud = longitud,",
				"\t\tVigenciaDesde = fecha_desde,",
				"\t\tVigenciaHasta = fecha_hasta,",
				"\t\tEstado = estado",
				"\t),",
				"\tskipDuplicateMapInputs: true,",
				"\tskipDuplicateMapOutputs: true) ~> renombrarXls2022",
				"xls2023 select(mapColumn(",
				"\t\tParadaHistoricaId = nro_parada,",
				"\t\tNombreParada = nombre_parada,",
				"\t\tZona = zona,",
				"\t\tLatitud = latitud,",
				"\t\tLongitud = longitud,",
				"\t\tVigenciaDesde = fecha_desde,",
				"\t\tVigenciaHasta = fecha_hasta,",
				"\t\tEstado = estado",
				"\t),",
				"\tskipDuplicateMapInputs: true,",
				"\tskipDuplicateMapOutputs: true) ~> renombrarXls2023",
				"renombrarCsv derive(AnioFuente = '2020-2021') ~> origenCsv",
				"renombrarXls2022 derive(AnioFuente = '2022') ~> origenXls2022",
				"renombrarXls2023 derive(AnioFuente = '2023') ~> origenXls2023",
				"origenCsv, origenXls2022, origenXls2023, sql union(byName: true)~> unirFuentes",
				"unirFuentes sink(allowSchemaDrift: true,",
				"\tvalidateSchema: false,",
				"\tinput(",
				"\t\tAnioFuente as string,",
				"\t\tParadaHistoricaId as string,",
				"\t\tCodigoPublicado as string,",
				"\t\tNombreParada as string,",
				"\t\tZona as string,",
				"\t\tLatitud as string,",
				"\t\tLongitud as string,",
				"\t\tVigenciaDesde as string,",
				"\t\tVigenciaHasta as string,",
				"\t\tEstado as string",
				"\t),",
				"\tdeletable:false,",
				"\tinsertable:true,",
				"\tupdateable:false,",
				"\tupsertable:false,",
				"\tformat: 'table',",
				"\tskipDuplicateMapInputs: true,",
				"\tskipDuplicateMapOutputs: true,",
				"\terrorHandlingOption: 'stopOnFirstError',",
				"\tmapColumn(",
				"\t\tAnioFuente,",
				"\t\tParadaHistoricaId,",
				"\t\tCodigoPublicado,",
				"\t\tNombreParada,",
				"\t\tZona,",
				"\t\tLatitud,",
				"\t\tLongitud,",
				"\t\tVigenciaDesde,",
				"\t\tVigenciaHasta,",
				"\t\tEstado",
				"\t)) ~> sinkBronze"
			]
		}
	}
}